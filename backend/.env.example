# ─────────────────────────────────────────────
# MySanad Backend – Environment Variables
# Copy this file to .env and fill values
# NEVER commit the real .env file to git
# ─────────────────────────────────────────────

# ── App ───────────────────────────────────────
ENVIRONMENT=production
API_BASE_URL=https://api.mysanad.shop
FRONTEND_URL=https://mysanad.shop
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────
# PostgreSQL connection string
# Easypanel internal Postgres service URL
DATABASE_URL=postgres://mysanad:mysanad@mysanad_database:5432/mysanad?sslmode=disable

# ── CORS ──────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=https://mysanad.shop

# ── Google Sheet Webhook ─────────────────────
# Orders are sent from THIS backend (not the Next.js frontend).
# 1. Open your Google Sheet → Extensions → Apps Script
# 2. Paste scripts/google-sheet-webhook.js → Save
# 3. Run testWebhook() once to authorize → check row in Orders tab
# 4. Deploy → New deployment → Web app (Execute as: Me, Access: Anyone)
# 5. Copy the /exec URL below AND in Easypanel → backend service → Environment
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_SECRET=
# Set to true to also push test orders (is_test=true) to the sheet
SEND_TEST_ORDERS_TO_SHEET=true

# ── MaxMind minFraud ──────────────────────────
# Sign up at https://www.maxmind.com → Account → My License Key
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_MINFRAUD_ENDPOINT=https://minfraud.maxmind.com/minfraud/v2.0/insights
# Block order if overall risk score exceeds this value (0–99). Tune after launch.
MAXMIND_MAX_RISK_SCORE=50
# Block order if IP-only risk score exceeds this value (0–99). Tune after launch.
MAXMIND_MAX_IP_RISK_SCORE=50
# Block orders when MaxMind API fails (timeout/HTTP error). Requires credentials above.
# Does NOT block when credentials are missing — configure MaxMind before enabling.
MAXMIND_REQUIRED=false
# Whitelisted test phone – bypasses MaxMind check, marks order is_test=true
ALLOW_TEST_PHONE=055000000

# ── Meta Conversions API ─────────────────────
# Pixel ID from Meta Events Manager → Data Sources
META_PIXEL_ID=
# System User Access Token with ads_management scope
META_ACCESS_TOKEN=
# Optional: paste test event code from Meta Test Events tab (dev only)
META_TEST_EVENT_CODE=

# ── TikTok Events API ────────────────────────
# Pixel ID from TikTok Ads Manager → Assets → Events
TIKTOK_PIXEL_ID=
# Long-lived Access Token from TikTok Events API setup
TIKTOK_ACCESS_TOKEN=

# ── Snapchat Conversions API ─────────────────
# Pixel ID from Snap Ads Manager → Assets → Pixels
SNAP_PIXEL_ID=
# OAuth2 long-lived token from Snap Marketing API
SNAP_ACCESS_TOKEN=

# ── Analytics Flags ──────────────────────────
# Set to false to disable all CAPI calls (useful in local dev with no tokens)
ANALYTICS_ENABLED=true
# Set to true to log full CAPI payloads to stdout (hashed PII only, never raw phone)
DEBUG_ANALYTICS=false
# Set to true to send real CAPI purchase events for test orders (055000000)
SEND_TEST_EVENTS=false

# ── Admin Dashboard ───────────────────────────
# Used by the protected /admin API routes through HTTP Basic auth
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Ad redirect manager (/redirecmysanad) ─────
# Separate credentials from the main admin dashboard
REDIRECT_ADMIN_USERNAME=
REDIRECT_ADMIN_PASSWORD=
